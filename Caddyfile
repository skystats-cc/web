{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# API paths go to the server, so the browser only ever talks to one origin
	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Link-preview bots get a tiny page with Open Graph tags for shareable pages (the SPA has none)
	@ogbots {
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|slackbot|telegrambot|whatsapp|linkedinbot|redditbot)
		path /p/* /bazaar/*
	}
	handle @ogbots {
		rewrite * /v1/og/page{uri}
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Never expose admin routes through the website
	handle /admin* {
		respond 404
	}

	handle {
		root * /srv
		# Hashed assets can be cached forever; everything else (index.html) must revalidate
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
